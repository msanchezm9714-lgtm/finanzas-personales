NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
NEXT_PUBLIC_CURRENCY=MXN

# Integración antigua, desactivada salvo que se establezca WHATSAPP_ENABLED=true.
WHATSAPP_ENABLED=false
# Solo en el servidor. Necesarios únicamente si vuelves a activar WhatsApp.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ALLOWED_SENDER=
WHATSAPP_USER_ID=
SUPABASE_SECRET_KEY=

# Chat con razonamiento (opcional). Sin esta clave, Walleto usa su motor local.
# Crea una clave en https://console.anthropic.com → API Keys. Solo servidor.
ANTHROPIC_API_KEY=
# Modelo opcional (por defecto claude-opus-5-5)
WALLETO_MODEL=
